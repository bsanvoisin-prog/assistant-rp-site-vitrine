---
layout: base.njk
type: "article"
---
<article class="post wrap">
  <p class="post-back"><a href="/blog/">← Tous les articles</a></p>
  {% if cover %}<img class="post-cover" src="{{ cover }}" alt="">{% endif %}
  <p class="post-meta">{{ date | readableDate }} · {{ author }}</p>
  <h1>{{ title }}</h1>
  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
