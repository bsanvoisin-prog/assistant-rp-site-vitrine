<!doctype html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#f7f7f4">
{%- set metaDescription = description or excerpt or 'Le blog Assistant-RP : actualités, méthode et conseils pour les relations médias.' %}
{%- set metaImage = site.url + (cover or '/assets/assistant-rp-logo.png') %}
{%- set pageUrl = site.url + page.url %}
<title>{{ title }} · Assistant-RP</title>
<meta name="description" content="{{ metaDescription }}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="{{ pageUrl }}">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/assets/main.css">
<link rel="stylesheet" href="/blog.css">

<meta property="og:site_name" content="Assistant-RP">
<meta property="og:type" content="{{ type or 'website' }}">
<meta property="og:locale" content="fr_FR">
<meta property="og:title" content="{{ title }} · Assistant-RP">
<meta property="og:description" content="{{ metaDescription }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ metaImage }}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }} · Assistant-RP">
<meta name="twitter:description" content="{{ metaDescription }}">
<meta name="twitter:image" content="{{ metaImage }}">

{%- if type == "article" %}
<meta property="article:published_time" content="{{ date | isoDate }}">
<meta property="article:author" content="{{ author }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | jsonify | safe }},
  "description": {{ metaDescription | jsonify | safe }},
  "datePublished": "{{ date | isoDate }}",
  "author": { "@type": "Organization", "name": {{ author | jsonify | safe }} },
  "publisher": { "@type": "Organization", "name": "Assistant-RP", "url": "{{ site.url }}" },
  "mainEntityOfPage": "{{ pageUrl }}",
  "image": "{{ metaImage }}"
}
</script>
{%- endif %}
<script src="/assets/tracking-config.js"></script>
<script src="/tarteaucitron/tarteaucitron.min.js"></script>
<script src="/assets/assistant-rp-tracking.js"></script>
</head>
<body>

<header id="top" class="site-header">
<nav class="wrap navigation" aria-label="Navigation principale">
  <a href="/#top" class="brand" aria-label="Assistant-RP, accueil">
    <span class="rp-logo" role="img" aria-label="Assistant-RP"><img alt="" width="725" height="219" src="/assets/assistant-rp-logo.png"></span>
  </a>
  <div class="nav-links">
    <a href="/#apercu">La plateforme</a>
    <a href="/#modules">Les modules</a>
    <a href="/#prix">Les prix</a>
    <a href="/blog/" aria-current="page">Blog</a>
  </div>
  <div class="nav-actions">
    <a class="login" href="https://app.assistant-rp.com/">Se connecter</a>
    <a class="button nav-signup" href="https://app.assistant-rp.com/">
      <span class="cta-label">Créer mon compte</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
    </a>
    <button class="menu-button" aria-label="Ouvrir le menu" aria-expanded="false">
      <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
      <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
    </button>
  </div>
</nav>
</header>

<main class="blog-main">
{{ content | safe }}
</main>

<footer class="wrap">
  <div>
    <a href="/#top" class="brand" aria-label="Assistant-RP, accueil">
      <span class="rp-logo" role="img" aria-label="Assistant-RP"><img alt="" width="725" height="219" src="/assets/assistant-rp-logo.png"></span>
    </a>
    <span>© {{ site.year }} Assistant-RP</span>
  </div>
  <div>
    <a class="legal-link" href="/#mentions">Mentions légales</a>
    <a class="legal-link" href="/#confidentialite">Confidentialité</a>
    <a class="legal-link" href="/#cgu">Conditions générales d’utilisation</a>
    <!-- Mission de tracking v2.1 (§5.1) : rouvre le panneau natif de
         tarteaucitron, déjà initialisé en tête de page — pas une modale
         maison qui en dupliquerait l'état. -->
    <a class="legal-link" href="javascript:void(0)" onclick="window.tarteaucitron && window.tarteaucitron.userInterface && window.tarteaucitron.userInterface.openPanel()">Gérer mes cookies</a>
    <a href="mailto:contact@assistant-rp.com">Contact <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></a>
  </div>
</footer>

<script src="/nav.js" defer></script>
<script>
  /* Mission de tracking v2.1, lot A : une seule catégorisation pour tout le
     blog plutôt qu'un identifiant par article — suffisant pour les tableaux
     de bord prévus (§11) et plus prudent au regard des catégories de charge
     utile interdites (01_CONTRAT_TRACKING.json) que d'exporter un slug. */
  window.arpAnalytics && window.arpAnalytics.page({
    content_id: (location.pathname === '/blog/' ? 'blog_index' : 'blog_article'),
    content_type: "{{ 'article' if type == 'article' else 'page' }}",
    content_theme: 'blog'
  });
</script>
</body>
</html>
