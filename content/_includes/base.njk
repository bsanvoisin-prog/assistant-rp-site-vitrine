<!doctype html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#f7f7f4">
{%- set metaDescription = description or excerpt or 'Le blog Assistant-RP : actualités, méthode et conseils pour les relations médias.' %}
{%- set metaImage = site.url + (cover or '/assets/assistant-rp-logo.png') %}
{%- set pageUrl = site.url + page.url %}
<title>{{ title }} · Assistant-RP</title>
<meta name="description" content="{{ metaDescription }}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="{{ pageUrl }}">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/assets/main.css">
<link rel="stylesheet" href="/blog.css">
<!-- 17/11 : icônes LinkedIn/YouTube du footer. Les pages du blog ne chargent
     jamais patch.js (c'est une autre sortie Eleventy, pas la SPA) — la même
     règle que patch.js injecte en JS côté app est donc dupliquée ici en CSS
     statique. Si .footer-social change d'un côté, la changer aussi ici. -->
<style>
.footer-social{display:inline-flex;align-items:center;gap:12px;margin-left:4px}
.footer-social a{display:inline-flex;color:var(--secondary,#60615b)}
.footer-social a:hover{color:var(--ink,#1a1a1a)}
.footer-social svg{width:20px;height:20px}
</style>

<meta property="og:site_name" content="Assistant-RP">
<meta property="og:type" content="{{ type or 'website' }}">
<meta property="og:locale" content="fr_FR">
<meta property="og:title" content="{{ title }} · Assistant-RP">
<meta property="og:description" content="{{ metaDescription }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ metaImage }}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }} · Assistant-RP">
<meta name="twitter:description" content="{{ metaDescription }}">
<meta name="twitter:image" content="{{ metaImage }}">

{%- if type == "article" %}
<meta property="article:published_time" content="{{ date | isoDate }}">
<meta property="article:author" content="{{ author }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | jsonify | safe }},
  "description": {{ metaDescription | jsonify | safe }},
  "datePublished": "{{ date | isoDate }}",
  "author": { "@type": "Organization", "name": {{ author | jsonify | safe }} },
  "publisher": { "@type": "Organization", "name": "Assistant-RP", "url": "{{ site.url }}" },
  "mainEntityOfPage": "{{ pageUrl }}",
  "image": "{{ metaImage }}"
}
</script>
{%- endif %}
<script src="/assets/tracking-config.js"></script>
<script src="/tarteaucitron/tarteaucitron.min.js"></script>
<script src="/assets/assistant-rp-tracking.js"></script>
</head>
<body>

<!-- Ancre de retour en haut de page, séparée du header : le header est en
     position sticky, et faire défiler jusqu'à un élément sticky est
     ambigu selon les moteurs (sa position affichée est toujours "en haut"
     une fois qu'on a scrollé, donc certains navigateurs — Firefox en
     particulier — considèrent qu'il est déjà visible et ne défilent pas).
     Cette ancre, elle, reste à sa vraie place dans le document. -->
<div id="top"></div>

<header class="site-header">
<nav class="wrap navigation" aria-label="Navigation principale">
  <a href="/#top" class="brand" aria-label="Assistant-RP, accueil">
    <span class="rp-logo" role="img" aria-label="Assistant-RP"><img alt="" width="1585" height="377" src="/assets/assistant-rp-logo.png"></span>
  </a>
  <div class="nav-links">
    <a href="/#apercu">La plateforme</a>
    <a href="/#modules">Les modules</a>
    <a href="/#prix">Les prix</a>
    <a href="/blog/" aria-current="page">Blog</a>
  </div>
  <div class="nav-actions">
    <a class="login" href="https://app.assistant-rp.com/">Se connecter</a>
    <a class="button nav-signup" href="https://app.assistant-rp.com/">
      <span class="cta-label">Créer mon compte</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
    </a>
    <button class="menu-button" aria-label="Ouvrir le menu" aria-expanded="false">
      <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
      <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
    </button>
  </div>
</nav>
</header>

<main class="blog-main">
{{ content | safe }}
</main>

<!-- 17/11 : bandeau "nos tutos en vidéo" avant le footer, sur toutes les
     pages du blog. Même habillage que l'ancien bandeau livre côté app
     (.book-banner, déjà dans main.css, masqué par patch.js sur la home) —
     classes réutilisées, pas de nouveau style à maintenir. -->
<aside class="book-banner" aria-label="Ressource complémentaire">
  <div class="wrap book-banner-row">
    <span class="book-banner-cover" aria-hidden="true" style="display:flex;align-items:center;justify-content:center;height:34px;color:#FF0000;box-shadow:none">
      <svg viewBox="0 0 576 512" width="26" height="23" aria-hidden="true"><path fill="currentColor" d="M549.7 124.1C543.5 100.4 524.9 81.8 501.4 75.5 458.9 64 288.1 64 288.1 64S117.3 64 74.7 75.5C51.2 81.8 32.7 100.4 26.4 124.1 15 167 15 256.4 15 256.4s0 89.4 11.4 132.3c6.3 23.6 24.8 41.5 48.3 47.8 42.6 11.5 213.4 11.5 213.4 11.5s170.8 0 213.4-11.5c23.5-6.3 42-24.2 48.3-47.8 11.4-42.9 11.4-132.3 11.4-132.3s0-89.4-11.4-132.3zM232.2 337.6l0-162.4 142.7 81.2-142.7 81.2z"/></svg>
    </span>
    <p><strong>Envie de voir plutôt que de lire&nbsp;? — </strong>nos tutos pour prendre en main Assistant RP sont sur notre chaîne YouTube.</p>
    <a class="book-banner-link" href="https://www.youtube.com/@assistant-rp" target="_blank" rel="noopener noreferrer">Voir les tutos <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></a>
  </div>
</aside>

<footer class="wrap">
  <div>
    <a href="/#top" class="brand" aria-label="Assistant-RP, accueil">
      <span class="rp-logo" role="img" aria-label="Assistant-RP"><img alt="" width="1585" height="377" src="/assets/assistant-rp-logo.png"></span>
    </a>
    <span>© {{ site.year }} Assistant-RP</span>
    <span class="footer-social">
      <a href="https://www.linkedin.com/company/assistant-rp/" target="_blank" rel="noopener noreferrer" aria-label="Assistant-RP sur LinkedIn">
        <svg viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M100.3 448l-92.9 0 0-299.1 92.9 0 0 299.1zM53.8 108.1C24.1 108.1 0 83.5 0 53.8 0 39.5 5.7 25.9 15.8 15.8s23.8-15.8 38-15.8 27.9 5.7 38 15.8 15.8 23.8 15.8 38c0 29.7-24.1 54.3-53.8 54.3zM447.9 448l-92.7 0 0-145.6c0-34.7-.7-79.2-48.3-79.2-48.3 0-55.7 37.7-55.7 76.7l0 148.1-92.8 0 0-299.1 89.1 0 0 40.8 1.3 0c12.4-23.5 42.7-48.3 87.9-48.3 94 0 111.3 61.9 111.3 142.3l0 164.3-.1 0z"/></svg>
      </a>
      <a href="https://www.youtube.com/@assistant-rp" target="_blank" rel="noopener noreferrer" aria-label="Assistant-RP sur YouTube">
        <svg viewBox="0 0 576 512" aria-hidden="true"><path fill="currentColor" d="M549.7 124.1C543.5 100.4 524.9 81.8 501.4 75.5 458.9 64 288.1 64 288.1 64S117.3 64 74.7 75.5C51.2 81.8 32.7 100.4 26.4 124.1 15 167 15 256.4 15 256.4s0 89.4 11.4 132.3c6.3 23.6 24.8 41.5 48.3 47.8 42.6 11.5 213.4 11.5 213.4 11.5s170.8 0 213.4-11.5c23.5-6.3 42-24.2 48.3-47.8 11.4-42.9 11.4-132.3 11.4-132.3s0-89.4-11.4-132.3zM232.2 337.6l0-162.4 142.7 81.2-142.7 81.2z"/></svg>
      </a>
    </span>
  </div>
  <div>
    <a class="legal-link" href="/#mentions">Mentions légales</a>
    <a class="legal-link" href="/#confidentialite">Confidentialité</a>
    <a class="legal-link" href="/#cgu">Conditions générales d’utilisation</a>
    <!-- Mission de tracking v2.1 (§5.1) : rouvre le panneau natif de
         tarteaucitron, déjà initialisé en tête de page — pas une modale
         maison qui en dupliquerait l'état. -->
    <a class="legal-link" href="javascript:void(0)" onclick="window.tarteaucitron && window.tarteaucitron.userInterface && window.tarteaucitron.userInterface.openPanel()">Gérer mes cookies</a>
    <a href="mailto:contact@assistant-rp.com">Contact <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></a>
  </div>
</footer>

<script src="/nav.js" defer></script>
<script>
  /* Mission de tracking v2.1, lot A : une seule catégorisation pour tout le
     blog plutôt qu'un identifiant par article — suffisant pour les tableaux
     de bord prévus (§11) et plus prudent au regard des catégories de charge
     utile interdites (01_CONTRAT_TRACKING.json) que d'exporter un slug. */
  window.arpAnalytics && window.arpAnalytics.page({
    content_id: (location.pathname === '/blog/' ? 'blog_index' : 'blog_article'),
    content_type: "{{ 'article' if type == 'article' else 'page' }}",
    content_theme: 'blog'
  });
</script>
</body>
</html>
